# --- API ---
PORT=5000
NODE_ENV=development

# --- Database (MongoDB Atlas) ---
# Copy this file to .env and paste your Atlas connection string, e.g.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ems?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ems

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS / Client ---
CLIENT_URL=http://localhost:5173
